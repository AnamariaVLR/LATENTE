---
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDictionary, type Locale } from '../i18n';
import { withBase } from '../config';

import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  locale: Locale;
  /** Sub-path within the locale (e.g. '' for home, 'inquire'). */
  path?: string;
  title: string;
  description: string;
  ogAlt: string;
  /** Header treatment: transparent over a hero, or a solid band. */
  headerTone?: 'over' | 'solid';
}

const {
  locale,
  path = '',
  title,
  description,
  ogAlt,
  headerTone = 'over',
} = Astro.props;

const t = getDictionary(locale);
const isArabic = locale === 'ar';
---

<!doctype html>
<html lang={t.htmlLang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e3a2c" />
    <meta name="generator" content={Astro.generator} />

    {/* Favicon set generated from the palm-tree mark (placeholder). */}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    {/* Preload the two variable fonts (they paint first) to avoid layout shift. */}
    <link
      rel="preload"
      href={withBase('/fonts/cormorant-garamond-var-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase('/fonts/eb-garamond-var-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      isArabic && (
        <link
          rel="preload"
          href={withBase('/fonts/amiri-400-arabic.woff2')}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }

    <SEO locale={locale} path={path} title={title} description={description} ogAlt={ogAlt} />

    {/* Seamless client-side navigation with cross-fade page transitions. */}
    <ClientRouter />
  </head>

  <body>
    <a href="#main" class="skip-link">{t.nav.skip}</a>

    <Header locale={locale} path={path} tone={headerTone} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} path={path} />

    {/* Scroll-reveal fallback for browsers without CSS scroll-driven animations.
        Where `animation-timeline: view()` is supported, the CSS in global.css
        drives the reveal and this observer simply isn't needed. Re-runs after
        every view transition (astro:page-load) and is idempotent. */}
    <script>
      function initReveal() {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const native = CSS.supports('animation-timeline: view()');
        const items = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-reveal-init])');

        items.forEach((el) => (el.dataset.revealInit = '1'));

        if (prefersReduced || native || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>

    {/* Restrained micro-interactions: a magnetic pull on primary buttons (fine
        pointers only) and the homepage section index. Both idempotent and
        re-bound after view transitions. */}
    <script>
      const fine = window.matchMedia('(pointer: fine)').matches;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function initMagnetic() {
        if (!fine || reduced) return;
        document.querySelectorAll<HTMLElement>('.cta:not([data-magnetic])').forEach((el) => {
          el.dataset.magnetic = '1';
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
            const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
            el.style.transform = `translate(${(dx * 10).toFixed(1)}px, ${(dy * 6).toFixed(1)}px)`;
          });
          el.addEventListener('pointerleave', () => {
            el.style.transform = '';
          });
        });
      }

      function initIndex() {
        const box = document.querySelector<HTMLElement>('.section-index');
        if (!box || box.dataset.init) return;
        box.dataset.init = '1';
        const current = box.querySelector<HTMLElement>('[data-current]');
        const targets = document.querySelectorAll<HTMLElement>('[data-index]');
        if (!current || !targets.length || !('IntersectionObserver' in window)) return;

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting && en.target instanceof HTMLElement) {
                current.textContent = en.target.dataset.index ?? '';
                box.classList.add('is-active');
              }
            });
          },
          { rootMargin: '-45% 0px -45% 0px' },
        );
        targets.forEach((t) => io.observe(t));

        // Stay out of the way while the hero fills the screen.
        const hero = document.querySelector('.hero');
        if (hero) {
          new IntersectionObserver(
            ([en]) => box.classList.toggle('is-hidden', !!en && en.intersectionRatio > 0.35),
            { threshold: [0, 0.35, 0.7] },
          ).observe(hero);
        }
      }

      function initAll() {
        initMagnetic();
        initIndex();
      }
      initAll();
      document.addEventListener('astro:page-load', initAll);
    </script>
  </body>
</html>
