---
// Hero: full-bleed misty wax-palm landscape, centred wordmark, the program line,
// and a single quiet "Inquire" link. Slow staged fade-in on load.
//
// Cinemagraph support: drop `hero-cocora-valley.mp4` (and/or `.webm`) into
// /public/images and the hero becomes a silent, looping video — detected at
// build time, with the responsive still as poster/fallback. Under
// prefers-reduced-motion the video is hidden and the still is shown instead.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Logo from './Logo.astro';
import { getDictionary, localizePath, type Locale } from '../i18n';
import { responsiveSources } from '../lib/images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const inquireHref = localizePath(locale, 'inquire');

const still = responsiveSources('/images/hero-cocora-valley.jpg');
const pub = join(process.cwd(), 'public', 'images');
const videoMp4 = existsSync(join(pub, 'hero-cocora-valley.mp4'));
const videoWebm = existsSync(join(pub, 'hero-cocora-valley.webm'));
const hasVideo = videoMp4 || videoWebm;
---

<section class:list={['hero', 'grain', { 'has-video': hasVideo }]} aria-label={t.hero.eyebrow}>
  <div class="hero__bg" aria-hidden="true">
    <picture>
      {
        still.responsive ? (
          <>
            <source type="image/avif" srcset={still.avif} sizes="100vw" />
            <source type="image/webp" srcset={still.webp} sizes="100vw" />
          </>
        ) : (
          <source type="image/webp" srcset={still.webpSingle} />
        )
      }
      <img
        src={still.fallback}
        alt={t.meta.ogAlt}
        fetchpriority="high"
        decoding="async"
        class="hero__img"
      />
    </picture>
    {
      hasVideo && (
        <video
          class="hero__video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={still.fallback}
        >
          {videoWebm && <source src="/images/hero-cocora-valley.webm" type="video/webm" />}
          {videoMp4 && <source src="/images/hero-cocora-valley.mp4" type="video/mp4" />}
        </video>
      )
    }
    <div class="hero__grade"></div>
    <div class="hero__scrim"></div>
  </div>

  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">{t.hero.eyebrow}</p>
    <Logo label={t.hero.wordmarkAlt} size="lg" as="h1" class="hero__wordmark" />
    <hr class="rule hero__rule" />
    <p class="hero__tagline">{t.hero.tagline}</p>
    <a href={inquireHref} class="link hero__inquire">{t.hero.inquire}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: clip;
    color: var(--on-dark);
    background: var(--forest-deep);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .hero__bg picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__img,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(var(--grade-saturate)) contrast(var(--grade-contrast));
  }
  .hero__img {
    /* A very slow, almost-imperceptible drift adds life to the still. */
    animation: hero-drift 26s ease-in-out infinite alternate;
  }
  .hero__video {
    position: absolute;
    inset: 0;
  }
  /* When a video plays, the still underneath is just a poster: no drift. */
  .has-video .hero__img {
    animation: none;
  }
  /* Unified colour cast shared with every photo section. */
  .hero__grade {
    position: absolute;
    inset: 0;
    background: var(--grade-tint);
    mix-blend-mode: color;
    opacity: var(--grade-tint-opacity);
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(
        120% 90% at 50% 45%,
        transparent 0%,
        color-mix(in srgb, var(--forest-deep) 55%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--forest-deep) 50%, transparent) 0%,
        color-mix(in srgb, var(--forest-deep) 30%, transparent) 50%,
        color-mix(in srgb, var(--forest-deep) 70%, transparent) 100%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-2xl);
  }

  /* Staged fade-in. Each element rises gently a touch after the previous. */
  .hero__eyebrow,
  .hero__wordmark,
  .hero__rule,
  .hero__tagline,
  .hero__inquire {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-in 1100ms var(--reveal-ease) forwards;
  }
  .hero__eyebrow { animation-delay: 200ms; }
  .hero__wordmark { animation-delay: 450ms; }
  .hero__rule { animation-delay: 800ms; }
  .hero__tagline { animation-delay: 1000ms; }
  .hero__inquire { animation-delay: 1300ms; }

  .hero__eyebrow {
    color: var(--on-dark);
  }
  .hero__rule {
    margin-block: var(--space-2xs);
  }
  .hero__tagline {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    max-width: 30ch;
    line-height: 1.4;
  }
  .hero__inquire {
    color: var(--on-dark);
    margin-block-start: var(--space-sm);
  }

  /* Scroll-linked depth: the hero image sinks slowly as the page scrolls away. */
  @supports (animation-timeline: view()) {
    .hero__bg picture,
    .hero__video {
      animation: hero-parallax linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-drift {
    from { transform: scale(1.06) translate3d(0, 0, 0); }
    to { transform: scale(1.12) translate3d(0, -1.5%, 0); }
  }
  @keyframes hero-parallax {
    from { transform: translateY(0); }
    to { transform: translateY(18%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img,
    .hero__bg picture,
    .hero__video {
      animation: none;
    }
    .hero__video {
      display: none;
    }
    .hero__eyebrow,
    .hero__wordmark,
    .hero__rule,
    .hero__tagline,
    .hero__inquire {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
