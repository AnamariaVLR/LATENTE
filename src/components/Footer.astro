---
// Footer: wordmark, single email contact, the two quiet secondary paths (dossier
// request → the inquiry form; privacy), language switcher, copyright.
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '' } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
const dossierHref = `${localizePath(locale, 'inquire')}?interest=dossier`;
const notesHref = localizePath(locale, 'insights');
const privacyHref = localizePath(locale, 'privacy');
---

<footer class="footer section--dark">
  <div class="container footer__inner">
    <Logo label={t.hero.wordmarkAlt} size="sm" />

    <a href={`mailto:${t.footer.email}`} class="footer__email link">{t.footer.email}</a>

    <nav class="footer__links" aria-label={t.footer.dossier}>
      <a href={dossierHref} class="link footer__link">{t.footer.dossier}</a>
      <span class="footer__sep" aria-hidden="true">·</span>
      <a href={notesHref} class="link footer__link">{t.footer.notes}</a>
      <span class="footer__sep" aria-hidden="true">·</span>
      <a href={privacyHref} class="link footer__link">{t.footer.privacy}</a>
    </nav>

    <LanguageSwitcher locale={locale} path={path} tone="dark" />

    <p class="footer__rights">© {year} {t.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-2xl);
    background: var(--forest);
    color: var(--on-dark);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-lg);
  }
  .footer__email {
    color: var(--on-dark);
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: var(--step-0);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-sm);
  }
  .footer__link {
    color: var(--on-dark);
  }
  .footer__sep {
    opacity: 0.4;
  }
  .footer__rights {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--on-dark) 60%, transparent);
    letter-spacing: 0.04em;
  }
</style>
