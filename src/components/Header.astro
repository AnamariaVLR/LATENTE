---
// Almost-invisible navigation: just the wordmark, a single "Inquire" link and
// the language switcher. No menu. On the homepage it sits transparently over the
// hero; on inner pages it rests on a solid forest band.
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDictionary, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Sub-path for the language switcher to preserve (e.g. '' or 'inquire'). */
  path?: string;
  /** 'over' = transparent over the hero; 'solid' = forest band on inner pages. */
  tone?: 'over' | 'solid';
}

const { locale, path = '', tone = 'over' } = Astro.props;
const t = getDictionary(locale);
const home = localizePath(locale);
const inquireHref = localizePath(locale, 'inquire');
const onInquire = path === 'inquire';
---

<header class:list={['header', `header--${tone}`, { 'is-top': tone === 'over' }]}>
  <div class="container header__inner">
    <a href={home} class="header__brand" aria-label={t.nav.home}>
      <Logo label={t.hero.wordmarkAlt} size="sm" />
    </a>

    <div class="header__end">
      {
        !onInquire && (
          <a href={inquireHref} class="link header__inquire">
            {t.nav.inquire}
          </a>
        )
      }
      <LanguageSwitcher locale={locale} path={path} tone="dark" />
    </div>
  </div>
</header>

{/* Without JS the header can't react to scroll, so reveal the wordmark + band. */}
<noscript>
  <style>
    .header--over {
      background: var(--forest) !important;
    }
    .header--over .header__brand {
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
    }
  </style>
</noscript>

<script>
  // Hide the wordmark while the hero fills the screen; fade it (and the forest
  // band) in once the page has scrolled past most of the first viewport.
  const header = document.querySelector('.header--over');
  if (header) {
    const update = () => {
      const trigger = Math.min(window.innerHeight * 0.6, 520);
      header.classList.toggle('is-top', window.scrollY < trigger);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>

<style>
  .header {
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 20;
    padding-block: var(--space-md);
    color: var(--on-dark);
  }
  /* On the homepage the header is fixed and transparent over the hero, then a
     forest band fades in as the page scrolls. (Inner pages use a solid band.) */
  .header--over {
    position: fixed;
    background: transparent;
    transition: background-color 500ms ease, box-shadow 500ms ease;
  }
  /* Scrolled state: the band appears. */
  .header--over:not(.is-top) {
    background: var(--forest);
    box-shadow: 0 1px 0 var(--hairline);
  }
  .header--solid {
    position: relative;
    background: var(--forest);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }
  .header__brand {
    text-decoration: none;
    color: inherit;
  }
  /* The wordmark is hidden while the hero is in view, then rises in on scroll. */
  .header--over .header__brand {
    transition: opacity 600ms ease, transform 600ms ease, visibility 600ms;
  }
  .header--over.is-top .header__brand {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .header--over,
    .header--over .header__brand {
      transition: none;
    }
  }
  .header__end {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-md), 4vw, var(--space-xl));
  }
  .header__inquire {
    color: var(--on-dark);
  }

  /* Mobile: the wordmark + Inquire + language switcher don't all fit on one row
     on narrow phones. Tighten the spacing, and below 22.5rem drop the header
     Inquire link (the hero and in-page CTAs still carry it) so nothing collides. */
  @media (max-width: 30rem) {
    .header__inner {
      gap: var(--space-sm);
    }
    .header__end {
      gap: var(--space-md);
    }
  }
  @media (max-width: 22.5rem) {
    .header__inquire {
      display: none;
    }
  }
</style>
