---
// A full-width page section with tall vertical rhythm and a constrained inner
// container. Variants control the colour treatment; image-backed variants always
// carry a gradient scrim so overlaid text stays AA-legible, plus a unified
// colour grade so every photograph reads as one film stock.
import { responsiveSources } from '../lib/images';

interface Props {
  id?: string;
  /**
   * light  — ivory background, ink text (default)
   * dark   — forest background, ivory text
   * image  — full-bleed background image + scrim, ivory text
   */
  variant?: 'light' | 'dark' | 'image';
  /** Background image JPG path (image variant only); AVIF/WebP derived. */
  image?: string;
  /** Scrim strength for the image variant. */
  scrim?: 'soft' | 'strong';
  /** Make an image section fill the viewport height (used for hero/editions). */
  full?: boolean;
  /** Add the subtle film-grain overlay. */
  grain?: boolean;
  /** Accessible label for the section landmark. */
  label?: string;
  /** Position shown in the homepage section index (e.g. "01"). */
  index?: string;
  class?: string;
}

const {
  id,
  variant = 'light',
  image,
  scrim = 'strong',
  full = false,
  grain = false,
  label,
  index,
  class: className = '',
} = Astro.props;

const scrimVar = scrim === 'strong' ? 'var(--scrim-strong)' : 'var(--scrim-soft)';
const src = image ? responsiveSources(image) : null;
---

<section
  id={id}
  aria-label={label}
  data-index={index}
  class:list={[
    'section',
    `section--${variant}`,
    { 'section--full': full, 'is-image': variant === 'image', grain },
    className,
  ]}
>
  {
    variant === 'image' && src && (
      <div class="section__bg" aria-hidden="true">
        <picture>
          {src.responsive ? (
            <>
              <source type="image/avif" srcset={src.avif} sizes="100vw" />
              <source type="image/webp" srcset={src.webp} sizes="100vw" />
            </>
          ) : (
            <source type="image/webp" srcset={src.webpSingle} />
          )}
          <img src={src.fallback} alt="" loading="lazy" decoding="async" class="section__img" />
        </picture>
        <div class="section__grade"></div>
        <div class="section__scrim" style={`--s:${scrimVar}`}></div>
      </div>
    )
  }
  <div class="container section__inner">
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    padding-block: var(--space-3xl);
    overflow: clip;
  }
  .section__inner {
    position: relative;
    z-index: 3;
  }

  .section--light {
    background: var(--ivory);
    color: var(--ink);
  }
  .section--dark {
    background: var(--forest);
    color: var(--on-dark);
  }
  /* Text-only sections below the fold can skip layout until near the viewport. */
  .section--light,
  .section--dark {
    content-visibility: auto;
    contain-intrinsic-size: auto 60svh;
  }
  .section--image {
    color: var(--on-dark);
    background: var(--forest-deep);
  }

  /* Image sections centre their content vertically. Full panels fill the
     viewport; non-full image sections still get a deliberate height so the
     photography has presence and reads as an intentional band, not a thin strip. */
  .section--image {
    display: grid;
    align-items: center;
  }
  .section--image:not(.section--full) {
    min-height: 66svh;
  }
  .section--full {
    min-height: 100svh;
  }

  .section__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .section__bg picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .section__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(var(--grade-saturate)) contrast(var(--grade-contrast));
  }
  /* Scroll-linked depth: the photo drifts a little slower than the text. The
     picture is oversized (scale) so the drift never reveals an edge. */
  @supports (animation-timeline: view()) {
    .section__bg picture {
      animation: section-parallax linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }
    @keyframes section-parallax {
      from { transform: scale(1.14) translateY(-5%); }
      to { transform: scale(1.14) translateY(5%); }
    }
  }
  /* Unified colour cast: a forest tint blended into the photo's hue. */
  .section__grade {
    position: absolute;
    inset: 0;
    background: var(--grade-tint);
    mix-blend-mode: color;
    opacity: var(--grade-tint-opacity);
  }
  /* Vertical gradient: darkest where text sits (centre), so contrast holds AA. */
  .section__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--forest-deep) calc(var(--s) * 100%), transparent) 0%,
      color-mix(in srgb, var(--forest-deep) calc(var(--s) * 118%), transparent) 50%,
      color-mix(in srgb, var(--forest-deep) calc(var(--s) * 100%), transparent) 100%
    );
  }
</style>
